rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'Mq5023789@gmail.com'
      );
    }

    // Validation Blueprint: UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'uid',
        'displayName',
        'plan',
        'appCredits',
        'flowConnected',
        'flowSubscriptionStatus',
        'flowCreditsAvailable',
        'preferredProvider',
        'apiFallbackEnabled',
        'separateBillingWarningAck',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'displayName',
        'photoURL',
        'plan',
        'appCredits',
        'flowConnected',
        'flowSubscriptionStatus',
        'flowCreditsAvailable',
        'preferredProvider',
        'apiFallbackEnabled',
        'separateBillingWarningAck',
        'createdAt',
        'updatedAt'
      ]) &&
      data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
      (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
      data.plan is string && data.plan in ['free', 'creator', 'pro', 'studio'] &&
      data.appCredits is number && data.appCredits >= 0 && data.appCredits <= 1000000 &&
      data.flowConnected is bool &&
      data.flowSubscriptionStatus is string && data.flowSubscriptionStatus in ['active_verified_user', 'unverified', 'disconnected'] &&
      data.flowCreditsAvailable is number && data.flowCreditsAvailable >= 0 && data.flowCreditsAvailable <= 1000000 &&
      data.preferredProvider is string && data.preferredProvider in ['google_flow_priority_1', 'google_veo_api_priority_2', 'procedural_cinema_priority_3'] &&
      data.apiFallbackEnabled is bool &&
      data.separateBillingWarningAck is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserPrivateInfo (PII Isolated)
    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid == userId &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp;
    }

    // Validation Blueprint: MusicProject
    function isValidMusicProject(data) {
      return data.keys().hasAll([
        'id',
        'ownerId',
        'title',
        'description',
        'directorStyle',
        'aspectRatio',
        'resolution',
        'durationSec',
        'bpm',
        'musicalKey',
        'mood',
        'lyricsText',
        'providerUsed',
        'status',
        'sceneCount',
        'completedScenes',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerId',
        'title',
        'description',
        'directorStyle',
        'aspectRatio',
        'resolution',
        'durationSec',
        'bpm',
        'musicalKey',
        'mood',
        'lyricsText',
        'providerUsed',
        'status',
        'sceneCount',
        'completedScenes',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.ownerId) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.description is string && data.description.size() <= 1000 &&
      data.directorStyle is string && data.directorStyle.size() >= 1 && data.directorStyle.size() <= 64 &&
      data.aspectRatio is string && data.aspectRatio in ['16:9', '9:16', '1:1'] &&
      data.resolution is string && data.resolution in ['720p', '1080p', '4K'] &&
      data.durationSec is number && data.durationSec >= 5 && data.durationSec <= 1800 &&
      data.bpm is number && data.bpm >= 40 && data.bpm <= 260 &&
      data.musicalKey is string && data.musicalKey.size() >= 1 && data.musicalKey.size() <= 32 &&
      data.mood is string && data.mood.size() >= 1 && data.mood.size() <= 64 &&
      data.lyricsText is string && data.lyricsText.size() <= 10000 &&
      data.providerUsed is string && data.providerUsed in ['google_flow_priority_1', 'google_veo_api_priority_2', 'procedural_cinema_priority_3'] &&
      data.status is string && data.status in ['draft', 'analyzing', 'storyboard_ready', 'generating_clips', 'editing', 'exported', 'failed', 'archived'] &&
      data.sceneCount is number && data.sceneCount >= 0 && data.sceneCount <= 200 &&
      data.completedScenes is number && data.completedScenes >= 0 && data.completedScenes <= 200 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Validation Blueprint: CharacterProfile
    function isValidCharacterProfile(data) {
      return data.keys().hasAll([
        'id',
        'ownerId',
        'name',
        'role',
        'appearancePrompt',
        'wardrobeLock',
        'hairstyleLock',
        'referenceImageUrl',
        'createdAt',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'id',
        'ownerId',
        'name',
        'role',
        'appearancePrompt',
        'wardrobeLock',
        'hairstyleLock',
        'referenceImageUrl',
        'createdAt',
        'updatedAt'
      ]) &&
      isValidId(data.id) &&
      isValidId(data.ownerId) &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
      data.role is string && data.role.size() >= 1 && data.role.size() <= 60 &&
      data.appearancePrompt is string && data.appearancePrompt.size() >= 1 && data.appearancePrompt.size() <= 1000 &&
      data.wardrobeLock is string && data.wardrobeLock.size() <= 500 &&
      data.hairstyleLock is string && data.hairstyleLock.size() <= 300 &&
      data.referenceImageUrl is string && data.referenceImageUrl.size() <= 1000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    // Collection: /users/{userId}
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().plan == 'free' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().plan == existing().plan &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'displayName',
              'photoURL',
              'appCredits',
              'flowConnected',
              'flowSubscriptionStatus',
              'flowCreditsAvailable',
              'preferredProvider',
              'apiFallbackEnabled',
              'separateBillingWarningAck',
              'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(userId) && isAdmin();

      // Subcollection: /users/{userId}/private/{infoId}
      match /private/{infoId} {
        allow get: if isValidId(userId) && isValidId(infoId) && (isOwner(userId) || isAdmin()) &&
          exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(infoId) &&
          infoId == 'info' &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().email == request.auth.token.email &&
          incoming().createdAt == request.time &&
          existsAfter(/databases/$(database)/documents/users/$(userId));
        allow update, delete: if false;
      }
    }

    // Collection: /projects/{projectId}
    match /projects/{projectId} {
      allow get: if isValidId(projectId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidMusicProject(incoming()) &&
        incoming().id == projectId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(projectId) &&
        isValidMusicProject(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'description',
              'directorStyle',
              'aspectRatio',
              'resolution',
              'durationSec',
              'bpm',
              'musicalKey',
              'mood',
              'lyricsText',
              'providerUsed',
              'status',
              'sceneCount',
              'completedScenes',
              'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(projectId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection: /characters/{characterId}
    match /characters/{characterId} {
      allow get: if isValidId(characterId) && isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser() &&
        isValidId(characterId) &&
        isValidCharacterProfile(incoming()) &&
        incoming().id == characterId &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if isVerifiedUser() &&
        isValidId(characterId) &&
        isValidCharacterProfile(incoming()) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          isAdmin() ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'role',
              'appearancePrompt',
              'wardrobeLock',
              'hairstyleLock',
              'referenceImageUrl',
              'updatedAt'
            ])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(characterId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // Collection: /admins/{adminId}
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isValidId(adminId) && isAdmin();
    }
  }
}
